# ==============================================================================

# SECURITY WARNING: DEBUG must ALWAYS be False in a production environment.
DEBUG=False
#


# To generate a new key, run this command in your terminal:
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
#
SECRET_KEY='ttendstack-super-secret-key-change-in-production-2024'
#

# ==============================================================================
#                               HOST SETTINGS
# ==============================================================================
#
# A list of the domains that are allowed to access your Django application.
ALLOWED_HOSTS=attendance.nextgenapplication.com,www.attendance.nextgenapplication.com,localhost,127.0.0.1
#

# ==============================================================================
#                               DATABASE SETTINGS
# ==============================================================================
#
# Using SQLite for now. For larger applications, consider PostgreSQL or MySQL.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# ==============================================================================
#                         CROSS-ORIGIN RESOURCE SHARING
# ==============================================================================
#
# A list of origins that are allowed to make API requests to your backend.
# This MUST include the URL of your live frontend application.
CORS_ALLOWED_ORIGINS=https://attendance.nextgenapplication.com,http://localhost:3000,http://127.0.0.1:3000
#
# ==============================================================================