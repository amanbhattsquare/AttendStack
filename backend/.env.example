# AttendStack Django Backend – Environment Variables Configuration

# ──────────────────────────────────────────────────────────────────────────────
# SECURITY & OPERATION MODE
# ──────────────────────────────────────────────────────────────────────────────
# True for local development, False for production VPS
DEBUG=True

# Unique secret key for production
SECRET_KEY=generate-a-secure-random-key-for-production

# Hostnames allowed to access Django (comma-separated, no spaces)
ALLOWED_HOSTS=localhost,127.0.0.1

# ──────────────────────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION
# ──────────────────────────────────────────────────────────────────────────────
# SQLite (Local Development):
# Automatically used when DEBUG=True and USE_POSTGRES_LOCALLY=False.
#
# PostgreSQL (Production):
# e.g., postgres://user:password@localhost:5432/dbname
DATABASE_URL=postgres://attendancestack_user:Attendance%40%23DB@localhost:5432/attendancestack_db

# Set to True if you want to use the PostgreSQL connection on localhost in development
USE_POSTGRES_LOCALLY=False

# ──────────────────────────────────────────────────────────────────────────────
# STATIC & CORS SETTINGS
# ──────────────────────────────────────────────────────────────────────────────
# Static files build directory (For production deployment, e.g. Nginx alias)
# Local defaults to backend root 'staticfiles/' directory.
# Production recommendation: /var/www/attendstack/static/
STATIC_ROOT=/var/www/attendstack/static/

# Allowed origins for CORS (comma-separated, no spaces)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
